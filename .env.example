# Copy to .env and fill in. NEVER commit the real .env.
# In GitHub Codespaces you can set these as Codespaces secrets instead.
DISCORD_TOKEN=
OPENROUTER_API_KEY=

# Fast/cheap: google/gemini-2.0-flash-001, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct
# Smarter:    anthropic/claude-3.5-sonnet, openai/gpt-4o, deepseek/deepseek-chat
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Role ID of the VIP role (right-click role > Copy Role ID)
VIP_ROLE_ID=

# Optional
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# CAPRICORN_DB_PATH=data/capricorn.db

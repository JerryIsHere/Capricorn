# Copy to .env and fill in. NEVER commit the real .env.
# In GitHub Codespaces you can set these as Codespaces secrets instead.
DISCORD_TOKEN=
OPENROUTER_API_KEY=

# Comma-separated, in priority order (max 1 primary + 3 fallbacks are used). Free model IDs change often:
# fallbacks ("models" routing) used automatically on rate limit / outage.
# Fast/cheap: google/gemini-2.0-flash-001, openai/gpt-4o-mini
# Smarter:    anthropic/claude-3.5-sonnet, openai/gpt-4o
OPENROUTER_MODELS=poolside/laguna-xs-2.1:free,xingchen-agi/xing4.0-29b-a4b:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Role ID of the VIP role (right-click role > Copy Role ID)
VIP_ROLE_ID=

# Optional
# Extra role IDs (comma-separated) that summon the bot when pinged; the bot's own role always works
# CAPRICORN_CALL_ROLE_IDS=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# CAPRICORN_DB_PATH=data/capricorn.db

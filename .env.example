# Copy to .env and fill in. NEVER commit the real .env.
# In GitHub Codespaces you can set these as Codespaces secrets instead.
DISCORD_TOKEN=
OPENROUTER_API_KEY=

# Comma-separated, in priority order. First = primary; the rest are sent as OpenRouter
# fallbacks ("models" routing) used automatically on rate limit / outage.
# Fast/cheap: google/gemini-2.0-flash-001, openai/gpt-4o-mini
# Smarter:    anthropic/claude-3.5-sonnet, openai/gpt-4o
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat:free,qwen/qwen-2.5-72b-instruct:free,google/gemini-2.0-flash-exp:free

# Role ID of the VIP role (right-click role > Copy Role ID)
VIP_ROLE_ID=

# Optional
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# CAPRICORN_DB_PATH=data/capricorn.db

# Copy to .env and fill in. NEVER commit the real .env.
# In GitHub Codespaces you can set these as Codespaces secrets instead.
DISCORD_TOKEN=
OPENROUTER_API_KEY=

# Comma-separated and tried in order. The bot always appends openrouter/free as the final fallback.
# Free model availability changes often; replace/add IDs as needed.
OPENROUTER_MODELS=poolside/laguna-xs-2.1:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free

# Role ID of the VIP role (right-click role > Copy Role ID)
VIP_ROLE_ID=

# Optional backup provider: Google Gemini (used only after every OpenRouter model fails;
# also works alone if OPENROUTER_API_KEY is empty). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated, tried in order (names containing "argon" are always ignored).
# Defaults: gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite

# Optional
# Extra role IDs (comma-separated) that summon the bot when pinged; the bot's own role always works
# CAPRICORN_CALL_ROLE_IDS=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# CAPRICORN_DB_PATH=data/capricorn.db
